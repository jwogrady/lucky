{
  "godaddy": {
    "title": "GoDaddy",
    "docs": "https://developer.godaddy.com/keys",
    "where": "Developer portal > API Keys > Create New API Key. Production, not OTE.",
    "services": {
      "api": {"fields": [
        {"label": "key", "secret": true},
        {"label": "secret", "secret": true},
        {"label": "base url", "default": "https://api.godaddy.com"},
        {"label": "auth header", "default": "Authorization: sso-key <key>:<secret>"}
      ], "verify": {"method": "GET", "path": "/v1/domains?limit=1", "expect": 200, "proves": "the key lists domains"}}
    }
  },
  "bluehost": {
    "title": "Bluehost",
    "where": "Bluehost cPanel. Most automation goes through cPanel's API token, not a Bluehost-specific one.",
    "services": {
      "cpanel": {"fields": [
        {"label": "username"},
        {"label": "api token", "secret": true},
        {"label": "base url", "help": "e.g. https://box1234.bluehost.com:2083"}
      ]}
    }
  },
  "cpanel": {
    "title": "cPanel",
    "docs": "https://api.docs.cpanel.net/cpanel/tokens/",
    "where": "cPanel > Security > Manage API Tokens > Create.",
    "services": {
      "api": {"fields": [
        {"label": "username"},
        {"label": "api token", "secret": true},
        {"label": "base url", "help": "https://<host>:2083"},
        {"label": "auth header", "default": "Authorization: cpanel <username>:<token>"}
      ], "verify": {"method": "GET", "path": "/execute/Quota/get_quota_info", "expect": 200, "proves": "UAPI accepted the token"}},
      "ssh": {"category": "SshKey", "fields": [
        {"label": "private key", "secret": true, "multiline": true, "help": "paste the whole key including BEGIN/END, then Ctrl-D"},
        {"label": "public key", "optional": true, "multiline": true},
        {"label": "host"},
        {"label": "username"},
        {"label": "port", "default": "22", "optional": true}
      ]}
    }
  },
  "cloudflare": {
    "title": "Cloudflare",
    "docs": "https://developers.cloudflare.com/fundamentals/api/get-started/create-token/",
    "where": "Dashboard > My Profile > API Tokens > Create Token. Scope it; do not use the Global API Key.",
    "services": {
      "api": {"fields": [
        {"label": "api token", "secret": true},
        {"label": "account id", "optional": true},
        {"label": "zone id", "optional": true},
        {"label": "base url", "default": "https://api.cloudflare.com/client/v4"},
        {"label": "auth header", "default": "Authorization: Bearer <api token>"}
      ], "verify": {"method": "GET", "path": "/user/tokens/verify", "expect": 200, "contains": "\"success\"", "proves": "the token is active"}}
    }
  },
  "google": {
    "title": "Google",
    "docs": "https://console.cloud.google.com/iam-admin/serviceaccounts",
    "where": "Cloud Console > IAM > Service Accounts > Keys > Add Key > JSON. Then grant the service account access in each product: Search Console, GA4, Business Profile, Tag Manager.",
    "services": {
      "service-account": {"fields": [
        {"label": "credential", "secret": true, "multiline": true, "help": "paste the whole JSON key file, then Ctrl-D"},
        {"label": "client email", "optional": true, "help": "the address to grant access to in each product"},
        {"label": "project id", "optional": true}
      ]},
      "ads": {"fields": [
        {"label": "developer token", "secret": true, "help": "Google Ads > Tools > API Center"},
        {"label": "client id"},
        {"label": "client secret", "secret": true},
        {"label": "refresh token", "secret": true},
        {"label": "login customer id", "optional": true, "help": "the MCC account, digits only"}
      ]},
      "maps-server": {"fields": [
        {"label": "credential", "secret": true, "help": "IP-restricted server key"},
        {"label": "base url", "default": "https://maps.googleapis.com/maps/api"}
      ], "verify": {
        "method": "GET", "path": "/geocode/json?address=10001&key=<credential>", "expect": 200,
        "contains": "\"status\" : \"OK\"",
        "proves": "geocoding accepted the key"
      }},
      "maps-browser": {"fields": [
        {"label": "credential", "secret": true, "help": "HTTP-referrer-restricted key; it is public in the bundle but still belongs in the vault"},
        {"label": "base url", "default": "https://maps.googleapis.com/maps/api"}
      ], "verify": {
        "method": "GET", "path": "/geocode/json?address=10001&key=<credential>", "expect": 200,
        "contains": "\"status\" : \"OK\"",
        "refusal": {"status": 200, "contains": "referer restrictions", "means": "refused server-side, as a referrer-restricted browser key should be"},
        "proves": "accepted server-side — check the key's referrer restriction"
      }}
    }
  },
  "housecallpro": {
    "title": "Housecall Pro",
    "docs": "https://docs.housecallpro.com/docs/housecall-public-api/",
    "where": "Settings > API. One key per integration.",
    "services": {
      "api": {"fields": [
        {"label": "credential", "secret": true},
        {"label": "base url", "default": "https://api.housecallpro.com"},
        {"label": "auth header", "default": "Authorization: Token <credential>"}
      ], "verify": {"method": "GET", "path": "/api/price_book/services?page_size=1", "expect": 200, "proves": "the price book is readable"}}
    }
  },
  "yext": {
    "title": "Yext",
    "where": "Developer Console > Apps > API Key.",
    "services": {
      "api": {"fields": [
        {"label": "credential", "secret": true},
        {"label": "account id", "optional": true},
        {"label": "api version", "default": "20240401", "optional": true}
      ]}
    }
  },
  "wordpress": {
    "title": "WordPress",
    "where": "Application Passwords live under Users > Profile. wp-cli goes over SSH to the host instead.",
    "services": {
      "application-password": {"fields": [
        {"label": "username"},
        {"label": "password", "secret": true, "help": "the application password, spaces and all"},
        {"label": "base url", "help": "https://example.com/wp-json"}
      ]}
    }
  },
  "supabase": {
    "title": "Supabase",
    "where": "Project Settings > API, and Settings > Database for the pooler URL.",
    "services": {
      "project": {"fields": [
        {"label": "url", "help": "public; appears in every browser bundle"},
        {"label": "publishable key"},
        {"label": "secret key", "secret": true},
        {"label": "password", "secret": true, "help": "database password; goes inside the pooler connection string"},
        {"label": "auth header", "default": "apikey: <secret key>\nAuthorization: Bearer <secret key>"}
      ], "verify": {"method": "GET", "path": "/rest/v1/", "expect": 200, "contains": "\"swagger\"", "proves": "the REST schema is readable with the secret key"}}
    }
  },
  "netlify": {
    "title": "Netlify",
    "where": "User settings > Applications > Personal access tokens.",
    "services": {
      "api": {"fields": [
        {"label": "credential", "secret": true},
        {"label": "site id", "optional": true},
        {"label": "base url", "default": "https://api.netlify.com/api/v1"},
        {"label": "auth header", "default": "Authorization: Bearer <credential>"}
      ], "verify": {"method": "GET", "path": "/user", "expect": 200, "proves": "the token identifies an account"}}
    }
  },
  "vultr": {
    "title": "Vultr",
    "where": "Account > API. Remember the IP allowlist.",
    "services": {
      "api": {"fields": [
        {"label": "credential", "secret": true},
        {"label": "base url", "default": "https://api.vultr.com/v2"},
        {"label": "auth header", "default": "Authorization: Bearer <credential>"}
      ], "verify": {"method": "GET", "path": "/account", "expect": 200, "proves": "the key reads the account"}}
    }
  }
}
